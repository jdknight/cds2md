<ac:structured-macro ac:name="jira">
    <ac:parameter ac:name="columns">key,summary,updated,status,resolution</ac:parameter>
    <ac:parameter ac:name="count">false</ac:parameter>
    <ac:parameter ac:name="jqlQuery">project = "TEST"</ac:parameter>
    <ac:parameter ac:name="maximumIssues">5</ac:parameter>
    <ac:parameter ac:name="server">test-server-name</ac:parameter>
    <ac:parameter ac:name="serverId">00000000-1234-0000-5678-000000000009</ac:parameter>
</ac:structured-macro>
